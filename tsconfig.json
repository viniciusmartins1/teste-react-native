{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["esnext"],
    "module": "esnext",
    "jsx": "react-native",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src"],
  "extends": "expo/tsconfig.base"
}
